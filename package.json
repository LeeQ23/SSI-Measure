{
  "name": "ssi-measure-desktop",
  "version": "1.0.0",
  "description": "SSI Measure Smart Inspection System - Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:frontend": "npm --prefix frontend run build",
    "app": "npm run build:frontend && electron ."
  },
  "build": {
    "appId": "com.ssimeasure.app",
    "productName": "SSI Measure",
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "backend/**/*",
      "frontend/dist/**/*"
    ]
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mysql2": "^3.22.4",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "electron": "^34.0.0"
  }
}
